# Copy this file to twilio.env and replace every placeholder with a real value.
# twilio.env is ignored by Git and Docker so credentials are never baked in.
export TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
export TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token
export TWILIO_FROM_NUMBER=+15551230000
export ALERT_RECIPIENTS=+15551232832,+15551232833
export SLACK_BOT_TOKEN=xoxb-replace-with-bot-token
export SLACK_CHANNEL_ID=C0123456789
